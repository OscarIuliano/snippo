{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "snippo-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every night at 03:17 UTC: data retention (src/retention.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "AUTH_BASE_URL": "http://localhost:5174",
    "DASHBOARD_ORIGIN": "http://localhost:5174",
    "PUBLIC_API_URL": "http://localhost:8787",
    // Cloudflare's test site key: always passes. TURNSTILE_SECRET (test value) is in .dev.vars.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "CHALLENGE_URL": "http://localhost:5173/challenge.html"
  },
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EVENTS_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "queues": {
    "producers": [{ "binding": "NOTIFICATIONS", "queue": "snippo-notifications-dev" }],
    "consumers": [
      {
        "queue": "snippo-notifications-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "snippo-notifications-dlq-dev"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snippo-dev",
      "database_id": "3abe3332-c5e0-4f90-8556-5571b9ab82ef",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    // Staging on workers.dev. Bindings are not inherited by environments: each one is listed here.
    "staging": {
      "name": "snippo-api-staging",
      "triggers": { "crons": ["17 3 * * *"] },
      "vars": {
        "AUTH_BASE_URL": "https://snippo-dashboard-staging.oiuliano90.workers.dev",
        "DASHBOARD_ORIGIN": "https://snippo-dashboard-staging.oiuliano90.workers.dev",
        "PUBLIC_API_URL": "https://snippo-api-staging.oiuliano90.workers.dev",
        // Test site key until a real Turnstile widget exists for the CDN hostname.
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "CHALLENGE_URL": "https://snippo-cdn-staging.oiuliano90.workers.dev/v1/challenge.html"
      },
      "ratelimits": [
        { "name": "SUBMIT_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "EVENTS_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snippo-staging",
          "database_id": "38ae2fc9-7c1e-4000-8d18-806d9c9695a2",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "NOTIFICATIONS", "queue": "snippo-notifications-staging" }],
        "consumers": [
          {
            "queue": "snippo-notifications-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "snippo-notifications-dlq-staging"
          }
        ]
      }
    }
  }
}
