---
import Icon from "../components/Icon.astro";
import { lastUpdated, legalPages } from "../legal";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "https://app.snippo.io";
---

<Layout title={`${title} · Snippo`} description={description}>
  <header class="border-b border-brand-900/5 bg-cream/80">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-ink">
        <span class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-sm shadow-brand-700/30">
          <Icon name="chat" class="size-4.5" />
        </span>
        snippo
      </a>
      <a href={`${appUrl}/accedi`} class="rounded-lg px-3 py-2 text-sm font-medium text-ink/80 transition hover:bg-brand-900/5 hover:text-ink">Accedi</a>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1>
    <p class="mt-2 text-sm text-ink/55">Ultimo aggiornamento: {lastUpdated}</p>
    <article class="legal mt-10">
      <slot />
    </article>
  </main>

  <footer class="border-t border-ink/5">
    <nav class="mx-auto flex max-w-3xl flex-wrap gap-x-6 gap-y-2 px-4 py-8 text-sm text-ink/55 sm:px-6" aria-label="Documenti legali">
      {legalPages.map((page) => <a href={page.href} class="transition hover:text-ink">{page.title}</a>)}
      <a href="/" class="transition hover:text-ink">Torna a Snippo</a>
    </nav>
  </footer>
</Layout>

<style is:global>
  .legal { color: color-mix(in oklab, var(--color-ink) 85%, transparent); line-height: 1.7; }
  .legal h2 { margin-top: 2.5rem; font-size: 1.25rem; font-weight: 700; color: var(--color-ink); }
  .legal h3 { margin-top: 1.5rem; font-weight: 600; color: var(--color-ink); }
  .legal p, .legal ul, .legal table { margin-top: 0.75rem; }
  .legal ul { list-style: disc; padding-left: 1.25rem; }
  .legal li + li { margin-top: 0.25rem; }
  .legal a { color: var(--color-brand-700); text-decoration: underline; text-underline-offset: 2px; }
  .legal strong { color: var(--color-ink); }
  .legal .table-wrap { overflow-x: auto; }
  .legal table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .legal th, .legal td { border-top: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent); padding: 0.5rem 0.75rem 0.5rem 0; text-align: left; vertical-align: top; }
  .legal th { font-weight: 600; color: var(--color-ink); }
</style>
