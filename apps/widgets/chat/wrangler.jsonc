{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // Static files only (no Worker script): the widget bundle, at /v1/snippo.js.
  "name": "snippo-cdn",
  "compatibility_date": "2025-09-01",
  // Exact paths: /v1/challenge.html must not be redirected to /v1/challenge.
  "assets": { "directory": "./dist", "html_handling": "none" },
  "env": {
    "staging": { "name": "snippo-cdn-staging" }
  }
}
